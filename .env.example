# Nebius Token Factory (required for live Nemotron + compliance)
NEBIUS_API_KEY=your_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/v1/sandboxes

# Tavily (optional — CVE/advisory enrichment / Best Use of Tavily path)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com

# Models (match IDs in Token Factory console)
ORCHESTRATOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
SPECIALIST_MODEL=nvidia/Nemotron-3-Super-120b-a12b
FAST_MODEL=nvidia/Nemotron-3-Nano-30B-A3B

SANDBOX_MODE=local
MAX_BRANCHES=3
MAX_ITERATIONS=5
PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO
DECISION_LOG_PATH=./logs/decisions.jsonl
