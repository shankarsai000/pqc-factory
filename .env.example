# Nebius Token Factory
NEBIUS_API_KEY=your_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Models (Nemotron family recommended)
ORCHESTRATOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
SPECIALIST_MODEL=nvidia/Nemotron-3-Super-120b-a12b
FAST_MODEL=nvidia/Nemotron-3-Nano-30B-A3B

# Sandbox
SANDBOX_MODE=local          # local | contree
MAX_BRANCHES=3
MAX_ITERATIONS=5

# Logging
LOG_LEVEL=INFO
DECISION_LOG_PATH=./logs/decisions.jsonl
